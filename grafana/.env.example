# Copy to .env and fill in. Both values come from the Cloudflare dashboard.
#
# CF_ACCOUNT_ID  Workers & Pages -> Account ID (32 hex characters)
# CF_AE_TOKEN    My Profile -> API Tokens -> Create Custom Token with
#                Account | Account Analytics | Read. The CLOUDFLARE_API_TOKEN
#                already in GitHub secrets is Workers Scripts:Edit and will
#                fail here — this has to be a second token.
CF_ACCOUNT_ID=
CF_AE_TOKEN=

# Publish address. 0.0.0.0 is the default because a 127.0.0.1 bind inside WSL2
# is unreachable from a Windows browser; on a plain Linux host use 127.0.0.1.
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
